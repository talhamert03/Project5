  "description": "Mürekkep Kalkanı — çizerek meteorları sektirdiğin, İstanbul'u koruduğun mobil arcade oyunu.",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "npm run build && node scripts/make-artifact.mjs",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
